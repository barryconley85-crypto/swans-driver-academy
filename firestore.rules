rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function profile(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
  function activeUser(){return signedIn()&&profile().active==true;}
  function manager(){return activeUser()&&profile().role in ['admin','manager','assessor'];}
  match /users/{uid}{
   allow read:if signedIn()&&(request.auth.uid==uid||manager());
   allow create:if false;
   allow update:if (signedIn()&&request.auth.uid==uid&&!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','active','depot','mustChangePassword','driverId','username']))||(signedIn()&&request.auth.uid==uid&&resource.data.mustChangePassword==true&&request.resource.data.mustChangePassword==false&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword','passwordChangedAt']));
   allow delete:if manager();
  }
  match /drivers/{id}{allow read,create,update:if manager();allow delete:if false;}
  match /assignments/{id}{allow read:if manager()||(activeUser()&&resource.data.driverUid==request.auth.uid);allow create,update,delete:if manager();}
  match /trainingRecords/{id}{allow read:if manager()||(activeUser()&&resource.data.driverUid==request.auth.uid);allow create,update:if manager()||(activeUser()&&request.resource.data.driverUid==request.auth.uid&&request.resource.data.status in ['in_progress','submitted','completed']&&(request.resource.data.status!='completed'||(request.resource.data.score is number&&request.resource.data.score>=80&&request.resource.data.signedName is string&&request.resource.data.signedName.size()>1&&(request.resource.data.courseId!='ctg-tt0004-distracted-driving'||request.resource.data.acknowledged==true))));allow delete:if false;}
  match /practicalAssessments/{id}{allow read:if manager()||(activeUser()&&resource.data.driverUid==request.auth.uid);allow create,update:if manager();allow delete:if false;}
  match /certificates/{id}{allow read:if manager()||(activeUser()&&resource.data.driverUid==request.auth.uid);allow write:if manager();}
  match /auditLog/{id}{allow read,create:if manager();allow update,delete:if false;}
  match /{document=**}{allow read,write:if false;}
 }
}